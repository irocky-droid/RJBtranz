# Git LFS configuration for large files
# Electron assets
electron/assets/*.png filter=lfs diff=lfs merge=lfs -text
electron/assets/*.ico filter=lfs diff=lfs merge=lfs -text
electron/assets/*.icns filter=lfs diff=lfs merge=lfs -text
electron/assets/*.jpg filter=lfs diff=lfs merge=lfs -text
# Public assets
public/assets/*.png filter=lfs diff=lfs merge=lfs -text
public/assets/*.ico filter=lfs diff=lfs merge=lfs -text
public/assets/*.icns filter=lfs diff=lfs merge=lfs -text
public/assets/*.jpg filter=lfs diff=lfs merge=lfs -text
# Release files
release/**/* filter=lfs diff=lfs merge=lfs -text
# Other large files
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.dmg filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.deb filter=lfs diff=lfs merge=lfs -text
*.rpm filter=lfs diff=lfs merge=lfs -text
*.AppImage filter=lfs diff=lfs merge=lfs -text
electron/assets/rjb-background.jpg filter=lfs diff=lfs merge=lfs -text
public/assets/rjb-background.jpg filter=lfs diff=lfs merge=lfs -text
